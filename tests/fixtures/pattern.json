        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^\\cA$",
          "maxLength": 10
        },
        "valid": false
      },
      {
        "description": "reject: \\p{C} unicode control category",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^\\p{C}+$",
          "maxLength": 10
