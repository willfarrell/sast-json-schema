        "valid": false
      },
      {
        "description": "reject: unbounded group repeat {n,} after a class holding )",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^[)]?(?:a){2,}$",
          "maxLength": 10
        },
        "valid": false
      },
