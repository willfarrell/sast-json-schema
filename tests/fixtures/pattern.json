        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^[a)*]$",
          "maxLength": 10
        },
        "valid": true
      },
      {
        "description": "accept: ){n,} inside a class is not an unbounded group repeat",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^[a){2,}]$",
          "maxLength": 10
        },
        "valid": true
      },
      {
        "description": "accept: (?= inside a class is not a lookahead",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^[(?=]$",
          "maxLength": 10
        },
        "valid": true
      },
      {
        "description": "accept: (?<= inside a class is not a lookbehind",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^[(?<=]$",
          "maxLength": 10
        },
        "valid": true
      },
      {
        "description": "accept: (?! inside a class is not a negative lookahead",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^[(?!]$",
          "maxLength": 10
        },
        "valid": true
      },
      {
        "description": "accept: (?<! inside a class is not a negative lookbehind",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
