          "pattern": "^[{]a{10000}$",
          "maxLength": 10
        },
        "valid": false
      },
      {
        "description": "reject: 5-digit {n,m} bound on a unicode property",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^\\p{L}{0,10000}$",
          "maxLength": 10
        },
        "valid": false
      }
    ]
  }
