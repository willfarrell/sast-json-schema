          "maxLength": 10
        },
        "valid": true
      },
      {
        "description": "reject: unbounded group repeat )+ after a class holding (",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^[(]?(?:a)+$",
          "maxLength": 10
