        "valid": false
      },
      {
        "description": "reject: positive lookahead (?=)",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^(?=a)ab$",
