        "valid": false
      },
      {
        "description": "reject: overlapping quantifiers [a-z]+[a-z]+",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^[a-z]+[a-z]+$",
          "maxLength": 10
        },
        "valid": false
      },
      {
