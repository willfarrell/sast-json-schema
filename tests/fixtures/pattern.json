        "description": "reject: positive lookahead after a class",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^[a](?=b)b$",
          "maxLength": 10
        },
