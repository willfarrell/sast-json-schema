          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^\\d+[0-9]+$",
          "maxLength": 10
        },
        "valid": false
      },
      {
        "description": "reject: \\w ⊃ \\d overlap",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^\\w+\\d+$",
          "maxLength": 10
        },
        "valid": false
      },
      {
        "description": "reject: negated character class [^...]",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^[^abc]+$",
          "maxLength": 10
        },
        "valid": false
      },
      {
        "description": "reject: bare | before any group",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^a|b$",
          "maxLength": 10
        },
        "valid": false
      },
      {
        "description": "accept: allowlist charset with ^ and $ anchors",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 10
        },
        "valid": true
      },
      {
        "description": "accept: bounded repetition",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^[a-z]{1,10}$",
          "maxLength": 10
        },
        "valid": true
      },
      {
        "description": "accept: escaped dot",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^a\\.b$",
          "maxLength": 10
        },
        "valid": true
      },
      {
        "description": "accept: dot inside character class",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^[a.b]+$",
          "maxLength": 10
        },
        "valid": true
      },
      {
        "description": "accept: alternation inside non-capturing group",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^(?:foo|bar)$",
          "maxLength": 10
        },
        "valid": true
      },
      {
        "description": "accept: | inside a character class is a literal",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^[a|b]+$",
          "maxLength": 10
        },
        "valid": true
      },
      {
        "description": "accept: | inside a character class inside a group is a literal",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^(?:x[a|b])$",
          "maxLength": 10
        },
        "valid": true
      },
      {
        "description": "accept: ) inside a character class does not close a group",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^(?:[)]|a)$",
          "maxLength": 10
        },
        "valid": true
      },
      {
        "description": "accept: escaped \\$ inside a group does not end a top-level |",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^(?:a|b\\$)$",
          "maxLength": 10
        },
        "valid": true
      },
      {
        "description": "reject: top-level | after a character class",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^[a]|[b]$",
          "maxLength": 10
