          "$id": "test",
          "type": "string",
          "pattern": "^(?:[(a+]){1,2}$",
          "maxLength": 10
        },
        "valid": true
      },
      {
        "description": "accept: ) and + inside a class are not an unbounded group repeat",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "pattern": "^[)+]$",
          "maxLength": 10
