[
	{
		"description": "definitions-only root is a library, not a typeless validator (2020-12)",
		"$comment": "A root may omit type/const/$ref/combinators only when it is a pure definitions library: metadata plus a non-empty definitions map. Otherwise the definitions key would silently disable the type requirement.",
		"schema": {
			"$ref": "urn:willfarrell:sast-json-schema:2020-12"
		},
		"tests": [
			{
				"description": "accept: metadata + non-empty definitions",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"title": "lib",
					"$defs": {
						"a": {
							"type": "string",
							"maxLength": 5,
							"enum": [
								"x"
							]
						}
					}
				},
				"valid": true
			},
			{
				"description": "reject: empty definitions map",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"$defs": {}
				},
				"valid": false
			},
			{
				"description": "reject: definitions beside validation keywords, no type",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"$defs": {
						"a": {
							"type": "string",
							"maxLength": 5,
							"enum": [
								"x"
							]
						}
					},
					"not": {
						"type": "null"
					}
				},
				"valid": false
			},
			{
				"description": "reject: definitions beside properties, no type",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"$defs": {
						"a": {
							"type": "string",
							"maxLength": 5,
							"enum": [
								"x"
							]
						}
					},
					"properties": {
						"a": {
							"type": "string",
							"maxLength": 5,
							"enum": [
								"x"
							]
						}
					},
					"required": [
						"a"
					],
					"additionalProperties": false,
					"maxProperties": 1
				},
				"valid": false
			}
		]
	},
