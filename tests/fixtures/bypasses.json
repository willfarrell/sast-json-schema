	{
		"description": "control characters via property classes, raw chars, and C1 escapes (2020-12)",
		"$comment": "safePattern bans control characters; \\p{Any}, \\p{ASCII}, gc=/General_Category= spellings, raw U+0000-U+001F/U+007F, and C1 (U+0080-U+009F) escapes are the same characters by another name.",
		"schema": {
			"$ref": "urn:willfarrell:sast-json-schema:2020-12"
		},
		"tests": [
			{
				"description": "accept: letters and numbers",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"type": "string",
					"maxLength": 100,
					"pattern": "^[\\p{L}\\p{N}]{1,100}$"
				},
				"valid": true
			},
			{
				"description": "accept: gc= spelling of a safe category",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"type": "string",
					"maxLength": 100,
					"pattern": "^\\p{gc=L}{1,100}$"
				},
				"valid": true
			},
			{
				"description": "accept: script property",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"type": "string",
					"maxLength": 100,
					"pattern": "^\\p{Script=Latin}{1,100}$"
				},
				"valid": true
			},
			{
				"description": "accept: whitespace escapes",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"type": "string",
					"maxLength": 100,
					"pattern": "^[a-z\\t\\r\\n ]{1,100}$"
				},
				"valid": true
			},
			{
				"description": "accept: Latin-1 letters past C1",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"type": "string",
					"maxLength": 100,
					"pattern": "^[\\u00c0-\\u00ff]{1,100}$"
				},
				"valid": true
			},
			{
				"description": "reject: \\p{Any}",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"type": "string",
					"maxLength": 100,
					"pattern": "^\\p{Any}{1,100}$"
				},
				"valid": false
			},
			{
				"description": "reject: \\p{ASCII}",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"type": "string",
					"maxLength": 100,
					"pattern": "^\\p{ASCII}{1,100}$"
				},
				"valid": false
			},
			{
				"description": "reject: \\p{Assigned}",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"type": "string",
					"maxLength": 100,
					"pattern": "^\\p{Assigned}{1,100}$"
				},
				"valid": false
			},
			{
				"description": "reject: \\p{gc=Cc}",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"type": "string",
					"maxLength": 100,
					"pattern": "^[\\p{gc=Cc}]{1,100}$"
				},
				"valid": false
			},
			{
				"description": "reject: \\p{General_Category=Control}",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"type": "string",
					"maxLength": 100,
					"pattern": "^\\p{General_Category=Control}{1,100}$"
				},
				"valid": false
			},
			{
				"description": "reject: \\p{General_Category=C}",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"type": "string",
					"maxLength": 100,
					"pattern": "^\\p{General_Category=C}{1,100}$"
				},
				"valid": false
			},
			{
				"description": "reject: raw NUL character",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"type": "string",
					"maxLength": 100,
					"pattern": "^[\u0000-\u001f]{1,10}$"
				},
				"valid": false
			},
			{
				"description": "reject: raw DEL character",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"type": "string",
					"maxLength": 100,
					"pattern": "^[a]{1,10}$"
				},
				"valid": false
			},
			{
				"description": "reject: C1 via \\x escape",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"type": "string",
					"maxLength": 100,
					"pattern": "^[\\x80-\\x9f]{1,10}$"
				},
				"valid": false
			},
			{
				"description": "reject: C1 via \\u escape",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"type": "string",
					"maxLength": 100,
					"pattern": "^\\u0085{1,10}$"
				},
				"valid": false
			},
			{
				"description": "reject: C1 via \\u{} escape",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"type": "string",
					"maxLength": 100,
					"pattern": "^\\u{9b}{1,10}$"
				},
				"valid": false
			}
		]
	},
	{
		"description": "top-level | behind nested groups breaks anchoring (2020-12)",
		"$comment": "^A|B$ matches anything starting with A or ending with B. The check must see through groups nested up to 3 deep (the CLI crawler covers any depth).",
		"schema": {
			"$ref": "urn:willfarrell:sast-json-schema:2020-12"
		},
		"tests": [
			{
				"description": "accept: alternation wrapped in one group",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"type": "string",
					"maxLength": 256,
					"pattern": "^(?:a|b)$"
				},
				"valid": true
			},
			{
				"description": "accept: nested groups inside a wrapping group",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"type": "string",
					"maxLength": 256,
					"pattern": "^(?:(?:a|b)|(?:c|d))$"
				},
				"valid": true
			},
			{
				"description": "accept: depth-3 nesting inside a wrapping group",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"type": "string",
					"maxLength": 256,
					"pattern": "^(?:(?:(?:a|b)|c)|d)$"
				},
				"valid": true
			},
			{
				"description": "reject: depth-2 groups either side of top-level |",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"type": "string",
					"maxLength": 256,
					"pattern": "^(?:(a)|b)|(?:(c)|d)$"
				},
				"valid": false
			},
			{
				"description": "reject: depth-3 groups either side of top-level |",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"type": "string",
					"maxLength": 256,
					"pattern": "^(?:(?:(a)|b)|c)|(?:(?:(d)|e)|f)$"
				},
				"valid": false
			},
			{
				"description": "reject: mixed depth-2/depth-3 either side",
				"data": {
					"$schema": "https://json-schema.org/draft/2020-12/schema",
					"$id": "test",
					"type": "string",
					"maxLength": 256,
					"pattern": "^(?:(a)|b)|(?:(?:(d)|e)|f)$"
				},
				"valid": false
			}
		]
	},
	{
