[
  {
    "description": "2019-09 draft-specific keywords",
    "schema": {
      "$ref": "urn:willfarrell:sast-json-schema:2019-09"
    },
    "tests": [
      {
        "description": "Should pass when using $recursiveAnchor: true with otherwise secure schema",
        "data": {
          "$schema": "https://json-schema.org/draft/2019-09/schema",
          "$id": "test",
          "$recursiveAnchor": true,
          "type": "object",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "unevaluatedProperties": false,
          "maxProperties": 10,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z]+$"
            }
          }
        },
        "valid": true
      },
      {
        "description": "Should pass when using $recursiveRef to a local fragment",
        "data": {
          "$schema": "https://json-schema.org/draft/2019-09/schema",
          "$id": "test",
          "$recursiveRef": "#/$defs/name",
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z]+$"
        },
        "valid": true
      },
      {
        "description": "Should fail when using $dynamicRef (2020-12 only)",
        "data": {
          "$schema": "https://json-schema.org/draft/2019-09/schema",
          "$id": "test",
          "$dynamicRef": "#foo",
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z]+$"
        },
        "valid": false
      },
      {
        "description": "Should fail when using $dynamicAnchor (2020-12 only)",
        "data": {
          "$schema": "https://json-schema.org/draft/2019-09/schema",
          "$id": "test",
          "$dynamicAnchor": "foo",
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z]+$"
        },
        "valid": false
      },
      {
        "description": "Should fail when using prefixItems (2020-12 only)",
        "data": {
          "$schema": "https://json-schema.org/draft/2019-09/schema",
          "$id": "test",
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "maxLength": 10,
              "pattern": "^[a-z]+$"
            }
          ],
          "maxItems": 10,
          "uniqueItems": true,
          "unevaluatedItems": false
        },
        "valid": false
      },
      {
        "description": "Should pass when schema uses $ref alone (no type required)",
        "data": {
          "$schema": "https://json-schema.org/draft/2019-09/schema",
          "$id": "test",
          "$ref": "#/$defs/name"
        },
        "valid": true
      },
      {
        "description": "Should fail when $schema declares 2020-12",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "test",
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z]+$"
        },
        "valid": false
      },
      {
        "description": "Should pass when `deprecated: true` is used (annotation is in 2019-09 spec)",
        "data": {
          "$schema": "https://json-schema.org/draft/2019-09/schema",
          "$id": "test",
          "type": "string",
          "maxLength": 8,
          "enum": ["a"],
          "deprecated": true
        },
        "valid": true
      },
      {
        "description": "Should fail when `deprecated` is non-boolean",
        "data": {
          "$schema": "https://json-schema.org/draft/2019-09/schema",
          "$id": "test",
          "type": "string",
          "maxLength": 8,
          "enum": ["a"],
          "deprecated": "yes"
        },
        "valid": false
      }
    ]
  },
  {
    "description": "2019-09 evaluates $ref siblings, so they stay allowed",
    "schema": {
      "$ref": "urn:willfarrell:sast-json-schema:2019-09"
    },
    "tests": [
      {
        "description": "Should pass when $ref has type, maxLength and pattern siblings",
        "data": {
          "$schema": "https://json-schema.org/draft/2019-09/schema",
          "$id": "test",
          "type": "object",
          "additionalProperties": false,
          "unevaluatedProperties": false,
          "maxProperties": 10,
          "required": ["name"],
          "properties": {
            "name": {
              "$ref": "#/$defs/name",
              "type": "string",
              "maxLength": 3,
              "pattern": "^a$"
            }
          },
          "$defs": {
            "name": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z]+$"
            }
          }
        },
        "valid": true
      }
    ]
  },
  {
    "description": "2019-09 propertyNames may share a key rule through a local $ref",
    "schema": {
      "$ref": "urn:willfarrell:sast-json-schema:2019-09"
    },
    "tests": [
      {
        "description": "Should pass when propertyNames is a bare $ref to #/$defs/<name>",
        "data": {
          "$schema": "https://json-schema.org/draft/2019-09/schema",
          "$id": "test",
          "type": "object",
          "unevaluatedProperties": false,
          "additionalProperties": {
            "type": "string",
            "maxLength": 8,
            "enum": ["a"]
          },
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "$defs": {
            "key": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z_]+$",
              "not": {
                "type": "string",
                "enum": [
                  "__proto__",
                  "constructor",
                  "prototype"
                ]
              }
            }
          },
          "maxProperties": 10,
          "required": []
        },
        "valid": true
      },
      {
        "description": "Should fail when propertyNames is only a remote $ref (the key rule cannot be checked)",
        "data": {
          "$schema": "https://json-schema.org/draft/2019-09/schema",
          "$id": "test",
          "type": "object",
          "unevaluatedProperties": false,
          "additionalProperties": {
            "type": "string",
            "maxLength": 8,
            "enum": ["a"]
          },
          "propertyNames": {
            "$ref": "https://schema.example.org/keys.json#/$defs/key"
          },
          "maxProperties": 10,
          "required": []
        },
        "valid": false
      }
    ]
  }
]
